# Core
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_activity"
# Local development URL (Vercel production can rely on VERCEL_URL instead)
NEXTAUTH_URL="http://127.0.0.1:3001"
NEXTAUTH_SECRET="replace-with-long-random-secret"

# SMTP / OTP email verification
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Campus Link <your-email@gmail.com>"

# Google OAuth (set both or leave both empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI assistant
ENABLE_AI_ASSISTANT="false"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Observability
ENABLE_SENTRY="false"
SENTRY_DSN=""
NEXT_PUBLIC_ENABLE_SENTRY="false"
NEXT_PUBLIC_SENTRY_DSN=""

# Optional scripts
APP_BASE_URL="http://127.0.0.1:3001"
COLLEGE_LIST_PATH="/absolute/path/to/6 List of Engineering colleges.txt"
ADMIN_EMAIL="admin@campuslink.com"
ADMIN_PASSWORD="replace-with-strong-password"
