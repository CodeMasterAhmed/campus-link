generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  BOTH
}

enum ExperienceType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  FREELANCE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TokenPurpose {
  SIGNUP_VERIFICATION
}

enum AIContextType {
  STUDENT_SELF
  STUDENT_PROFILE
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model College {
  id                       Int                       @id @default(autoincrement())
  name                     String
  code                     String                    @unique
  emailDomain              String                    @unique
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  users                    User[]
  studentAcademics         StudentAcademic[]
  messages                 Message[]
  recruiterCollegeRequests RecruiterCollegeRequest[]
}

model User {
  id                        Int                       @id @default(autoincrement())
  collegeId                 Int?
  college                   College?                  @relation(fields: [collegeId], references: [id])

  name                      String
  email                     String                    @unique
  passwordHash              String?
  role                      Role
  status                    UserStatus                @default(ACTIVE)
  authProvider              AuthProvider              @default(PASSWORD)
  emailVerifiedAt           DateTime?
  profileImageUrl           String?

  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  // relations
  studentProfile            StudentProfile?
  recruiterProfile          RecruiterProfile?
  sentMessages              Message[]                 @relation("SentMessages")
  receivedMessages          Message[]                 @relation("ReceivedMessages")
  recruiterRequests         RecruiterCollegeRequest[] @relation("RecruiterRequests")
  resolvedRequests          RecruiterCollegeRequest[] @relation("ResolvedByAdmin")
  emailVerificationTokens   EmailVerificationToken[]
  aiConversations           AIConversation[]
  recruiterWatchlist        RecruiterWatchlist[]
}

model StudentAcademic {
  id             Int        @id @default(autoincrement())
  collegeId      Int
  college        College    @relation(fields: [collegeId], references: [id])

  rollNumber     String
  studentName    String?
  currentCgpa    Decimal?   @db.Decimal(4, 2)
  overallSgpa    Decimal?   @db.Decimal(4, 2)
  batchYear      Int?
  branch         String?
  semesters      Json?
  lastScrapedAt  DateTime   @default(now())
  rawPayload     Json?

  studentProfile StudentProfile?
  studentResults StudentResult[]
  recruiterWatchlist RecruiterWatchlist[]

  @@unique([collegeId, rollNumber])
}

model StudentProfile {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique
  user              User            @relation(fields: [userId], references: [id])

  academicId        Int             @unique
  academic          StudentAcademic @relation(fields: [academicId], references: [id])

  headline          String?
  about             String?
  yearOfStudy       Int?
  ussScore          Decimal?        @db.Decimal(6, 2)
  profileCompleted  Boolean         @default(false)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  skills            StudentSkill[]
  experiences       StudentExperience[]
  certifications    StudentCertification[]
}

model RecruiterProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String?
  companyWebsite String?
  companyAbout  String?
  hiringFocus   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StudentSkill {
  id                Int            @id @default(autoincrement())
  studentProfileId  Int
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id])

  category          String         // e.g. 'Programming', 'Framework'
  name              String         // e.g. 'React', 'Go'

  createdAt         DateTime       @default(now())

  @@unique([studentProfileId, category, name])
}

model StudentExperience {
  id                Int             @id @default(autoincrement())
  studentProfileId  Int
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id])

  type              ExperienceType
  companyName       String
  roleTitle         String
  startDate         DateTime        @db.Date
  endDate           DateTime?       @db.Date
  isCurrent         Boolean         @default(false)
  description       String?

  createdAt         DateTime        @default(now())
}

model StudentCertification {
  id                Int             @id @default(autoincrement())
  studentProfileId  Int
  studentProfile    StudentProfile  @relation(fields: [studentProfileId], references: [id])

  name              String
  issuer            String?
  issueDate         DateTime?       @db.Date
  expiryDate        DateTime?       @db.Date
  credentialUrl     String?

  createdAt         DateTime        @default(now())
}

model RecruiterCollegeRequest {
  id                Int            @id @default(autoincrement())

  recruiterId       Int
  recruiter         User           @relation("RecruiterRequests", fields: [recruiterId], references: [id])

  targetCollegeId   Int
  targetCollege     College        @relation(fields: [targetCollegeId], references: [id])

  status            RequestStatus  @default(PENDING)
  reason            String?

  createdAt         DateTime       @default(now())
  resolvedAt        DateTime?
  resolvedByAdminId Int?
  resolvedByAdmin   User?          @relation("ResolvedByAdmin", fields: [resolvedByAdminId], references: [id])
}

model Message {
  id          Int      @id @default(autoincrement())

  collegeId   Int
  college     College  @relation(fields: [collegeId], references: [id])

  senderId    Int
  receiverId  Int
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  body        String
  createdAt   DateTime @default(now())
  readAt      DateTime?
}

model EmailVerificationToken {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id])

  tokenHash   String
  token       String?
  purpose     TokenPurpose
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@unique([userId, purpose, tokenHash])
  @@index([userId, purpose, consumedAt, expiresAt])
}

model ResultLink {
  id            Int      @id @default(autoincrement())
  url           String   @unique
  title         String
  publishedDate DateTime?
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  exams         Exam[]
}

enum ExamType {
  MAIN
  BACKLOG
  REVAL
  SUPPLEMENTARY
}

model Exam {
  id           Int          @id @default(autoincrement())
  name         String
  monthYear    String?
  semester     Int?
  type         ExamType     @default(MAIN)
  
  resultLinkId Int
  resultLink   ResultLink   @relation(fields: [resultLinkId], references: [id])
  
  studentResults StudentResult[]
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum ResultStatus {
  PASSED
  FAILED
  PROMOTED
  DETAINED
  MALPRACTICE
  ABSENT
}

model StudentResult {
  id                Int             @id @default(autoincrement())
  rollNumber        String
  
  examId            Int
  exam              Exam            @relation(fields: [examId], references: [id])
  
  sgpa              Decimal?        @db.Decimal(4, 2)
  backlogCount      Int?
  resultStatus      ResultStatus
  
  studentAcademicId Int?
  studentAcademic   StudentAcademic? @relation(fields: [studentAcademicId], references: [id])
  
  subjectResults    SubjectResult[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([rollNumber, examId])
}

model SubjectResult {
  id              Int           @id @default(autoincrement())
  studentResultId Int
  studentResult   StudentResult @relation(fields: [studentResultId], references: [id])
  
  subjectCode     String
  subjectName     String
  grade           String?
  credits         Decimal?      @db.Decimal(3, 1)
  resultStatus    ResultStatus
  
  createdAt       DateTime      @default(now())
}

model AIConversation {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id])
  title             String
  contextType       AIContextType
  contextRollNumber String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  messages          AIMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model AIMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model RecruiterWatchlist {
  id                Int             @id @default(autoincrement())
  recruiterId       Int
  recruiter         User            @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  studentAcademicId Int
  studentAcademic   StudentAcademic @relation(fields: [studentAcademicId], references: [id], onDelete: Cascade)
  note              String?
  tagsJson          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([recruiterId, studentAcademicId])
  @@index([recruiterId, createdAt(sort: Desc)])
}

model ApiRateLimitEvent {
  id        Int      @id @default(autoincrement())
  identity  String
  action    String
  createdAt DateTime @default(now())

  @@index([identity, action, createdAt])
  @@index([createdAt])
}
